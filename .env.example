# The AI Company: your secrets. Copy this file to `.env` next to aic.config.yaml and fill in what you use.
# `.env` is git-ignored. Real environment variables win over values in this file.
# aic.config.yaml only ever names these variables; it never contains the values.

# ---------------------------------------------------------------- AI models (only what you configure)
# Keys can also be pasted in the dashboard (Setup → AI models); those are encrypted into your storage vault instead.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Lifetime spend cap in USD per API key, across every run and process (recommended).
# Before each call the worst case is checked; a call that could cross the cap is refused.
# AIC_SPEND_CAP_USD=5.00
# Where that spend is recorded (default: ~/.aic/spend-ledger.json).
# AIC_SPEND_LEDGER=

# ---------------------------------------------------------------- Database (production)
# Used when aic.config.yaml has `database: { url_env: DATABASE_URL }`. Without it, an embedded database in .aic/db is used.
# DATABASE_URL=postgres://aic_engine:change-me@db.example.com:5432/aic

# ---------------------------------------------------------------- Code hosting
# Used when aic.config.yaml has `code_hosting: { kind: github, repo: your-org/your-repo, token_env: GITHUB_TOKEN }`.
# A fine-grained token with Contents + Pull requests read/write on that one repository.
# GITHUB_TOKEN=github_pat_...

# ---------------------------------------------------------------- Dashboard sign-in
# A fixed owner token for `aic serve` (otherwise a new one is printed at each start). It acts as the CEO.
# AIC_DASHBOARD_TOKEN=
# Google sign-in (aic.config.yaml → auth.google): the OAuth client secret from YOUR Google Cloud project.
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Signs dashboard session cookies (otherwise generated into your storage folder).
# AIC_SESSION_SECRET=

# ---------------------------------------------------------------- Platform keys (production: from your secret manager)
# Encrypts the vault of keys and passwords entered in the dashboard: 32 bytes as 64 hex characters.
# Otherwise generated into <storage>/master.key. Keep a backup: losing it makes stored keys unreadable.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AIC_MASTER_KEY=
# Signs short-lived run credentials (otherwise generated into <storage>/credential.secret).
# AIC_CREDENTIAL_SECRET=

# ---------------------------------------------------------------- CI regression signal (optional)
# Shared secret for POST /api/hooks/ci (HMAC-SHA256 of the raw body in the x-aic-signature header).
# AIC_CI_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Troubleshooting
# Print full stack traces from the CLI (same as --verbose).
# AIC_DEBUG=1
